# searchd's local data (keyword results, history, cache). It lives in whatever folder you run
# searchd from; this keeps it out of the repo if you try searchd here.
.searchd/

# OS clutter and temp files
.DS_Store
*.tmp
node_modules/

# Leftovers from running `npx skills add/remove` with PROJECT scope inside this repo.
# Never do that here: the installer treats this repo's skills/ folder (searchd's source)
# as an install location, and a project-scope remove deletes it. Use -g (global).
.agents/
.claude/skills/
skills-lock.json
